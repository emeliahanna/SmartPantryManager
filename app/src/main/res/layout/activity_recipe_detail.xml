<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="#FFFFFF">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recipe Details"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#243B2A"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/textDetailRecipeName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recipe Name"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#243B2A"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/textDetailDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recipe description"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/textDetailCookingTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cooking time"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Required Ingredients"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#243B2A"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/textDetailIngredients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ingredients will appear here"
            android:textSize="16sp"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cooking Instructions"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#243B2A"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/textDetailInstructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Instructions will appear here"
            android:textSize="16sp"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/buttonBackToRecipes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back to Suggested Recipes" />

    </LinearLayout>
</ScrollView>
