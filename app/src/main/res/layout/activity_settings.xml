<?xml version="1.0" encoding="utf-8"?>
<!--scrollable layout for app settings-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!--setting screen heading-->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!--dispklay preferences section heading-->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Preferences"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!--allow user to enable or disable expiry alerts preference-->
        <CheckBox
            android:id="@+id/checkExpiryAlerts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable expiring-soon alerts"
            android:textSize="16sp"
            android:padding="8dp" />

        <!--explain expiry alerts preference-->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable this option to indicate that you want reminders about ingredients approaching their expiry dates."
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp" />

        <!--save selected settings-->
        <Button
            android:id="@+id/buttonSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Settings" />

        <!--return to pantry screen-->
        <Button
            android:id="@+id/buttonBackToPantry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back to Pantry"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>
